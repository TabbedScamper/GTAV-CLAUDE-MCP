"""
re_tools_dynamic.py  -  RE TOOLKIT, Tier B (DYNAMIC / game-dependent)   *** UNTESTED ***
================================================================================================
These reach into LIVE game state, so they cannot be validated off-game. The LOGIC follows
confirmed sources (Menyoo GTAmemory for pools, ScriptHookV getGlobalPtr for globals), but the
**AOB patterns + struct offsets are build-specific** and MUST be verified in-game before trusting.

    read_global / write_global   script-VM globals (Global_xxxxx) via ScriptHookV's getGlobalPtr
    enumerate_entities           walk the ped/vehicle/object pools -> entity pointers (+ handles)
    nearby_peds / nearby_vehicles output-pointer natives (GET_PED_NEARBY_*) via a ctypes buffer

Tier B "experimental" (hardware-breakpoint `watch_access` / `trace_func`) is intentionally NOT here
-- a wrong offset there hard-crashes GTA. Build it WITH the game running per RE-TOOLKIT.md section 3.1.

INTEGRATION: same as re_tools.py -- `import re_tools_dynamic as rtd; rtd.bind(globals());
COMMANDS.update(rtd.RE_DYN_COMMANDS)`. These call natives/engine functions, so they are NOT
off-thread (they need the live game tick) -- do NOT add them to _OFFTHREAD_COMMANDS.
"""
import ctypes
import struct

_P = {}
def bind(bridge_globals: dict):
    """Pull bridge primitives. Needs: read_bytes, read_ptr, is_valid_address, _get_main_module,
    _joaat, handle_call_function, handle_call_native_by_name, gta, PYLOADER_AVAILABLE, log_message."""
    for n in ("read_bytes", "read_ptr", "is_valid_address", "_get_main_module", "_joaat",
              "handle_call_function", "handle_call_native_by_name", "gta",
              "PYLOADER_AVAILABLE", "log_message", "note_finding", "_FINDINGS"):
        if n in bridge_globals:
            _P[n] = bridge_globals[n]

def _u32(a):
    b = _P["read_bytes"](a, 4); return struct.unpack("<I", b)[0] if b else None
def _u64(a):
    b = _P["read_bytes"](a, 8); return struct.unpack("<Q", b)[0] if b else None
def _resolve(v):
    return (int(v, 16) if v.lower().startswith("0x") else int(v)) if isinstance(v, str) else int(v)

_MODULE_FLOOR = 0x7FF000000000   # module/code addresses sit above this; GTA heap sits well below
def _looks_heap(p):
    """True if p looks like a user-mode heap pointer (a real pool's data ptr), not module/code/null."""
    return bool(p) and 0 < p < _MODULE_FLOOR

# ============================================================================
# Script-VM globals  (ScriptHookV getGlobalPtr  ->  block=i>>18, slot=i&0x3FFFF, 8-byte slots)
# This is the lowest-risk Tier B feature (SHV does the math; we just deref).
# ============================================================================
_getGlobalPtr = None
def _global_ptr_fn():
    global _getGlobalPtr
    if _getGlobalPtr is None:
        dll = ctypes.CDLL("ScriptHookV.dll")
        fn = dll["?getGlobalPtr@@YAPEA_KH@Z"]          # mangled export
        fn.restype = ctypes.POINTER(ctypes.c_uint64)
        fn.argtypes = [ctypes.c_int]
        _getGlobalPtr = fn
    return _getGlobalPtr

def read_global(index, kind="int"):
    """Read script Global_<index>. kind: int|uint|float|hex."""
    try:
        p = _global_ptr_fn()(int(index))
    except Exception as e:
        return {"error": f"getGlobalPtr failed (ScriptHookV.dll loaded?): {e}"}
    if not p:
        return {"error": f"global {index} returned null"}
    raw = p[0]
    val = {"int": ctypes.c_int64(raw).value, "uint": raw,
           "float": struct.unpack("<f", struct.pack("<Q", raw)[:4])[0],
           "hex": f"0x{raw:X}"}.get(kind, ctypes.c_int64(raw).value)
    return {"success": True, "index": int(index), "raw": f"0x{raw:X}", "value": val}

def write_global(index, value, kind="int"):
    """Write script Global_<index>. CONFIRM with the user; globals drive gameplay/mission state."""
    try:
        p = _global_ptr_fn()(int(index))
    except Exception as e:
        return {"error": f"getGlobalPtr failed: {e}"}
    if not p:
        return {"error": f"global {index} returned null"}
    old = p[0]
    if kind == "float":
        p[0] = struct.unpack("<Q", struct.pack("<f", float(value)) + b"\x00\x00\x00\x00")[0]
    else:
        p[0] = int(value) & 0xFFFFFFFFFFFFFFFF
    return {"success": True, "index": int(index), "old": f"0x{old:X}", "new": f"0x{p[0]:X}"}

# ============================================================================
# Entity pools  (Menyoo GTAmemory layout + Legacy AOBs -- VERIFY IN-GAME)
# Pattern resolve: pool_ptr_global = addr + 7 + *(int32*)(addr+3)  (the "48 8B 05 <rip>" form)
# ============================================================================
_POOL_AOB = {  # (pattern, kind)  kind: "vehicle" uses bit-array; "generic" uses byte-array
    "vehicle": ("48 8B 05 ?? ?? ?? ?? F3 0F 59 F6 48 8B 08", "vehicle"),
    "ped":     ("48 8B 05 ?? ?? ?? ?? 41 0F BF C8 0F BF 40 10", "generic"),
    "object":  ("48 8B 05 ?? ?? ?? ?? 8B 78 10 85 FF", "generic"),
}

def _scan_first(pattern):
    """Scan the main module for an AOB; return the first match address (or None). Uses re_tools."""
    try:
        import re_tools
        r = re_tools.re_scan(pattern, limit=1)
        m = r.get("matches") or []
        return int(m[0], 16) if m else None
    except Exception:
        return None

def _resolve_pool_global(pattern):
    """Resolve the '48 8B 05 <rip32>' pool-pointer global address, then double-deref to the pool."""
    addr = _scan_first(pattern)
    if not addr:
        return None
    disp = _u32(addr + 3)
    if disp is None:
        return None
    if disp & 0x80000000:                          # signed rip displacement
        disp -= 0x100000000
    pool_global = addr + 7 + disp                   # address of the global pointer
    p1 = _u64(pool_global)                          # *_poolAddress
    if not p1:
        return None
    return _u64(p1) or p1                           # the pool struct pointer (Menyoo double-deref)

def _iter_vehicle_pool(pool):
    size = _u32(pool + 0x08) or 0
    pool_arr = _u64(pool + 0x00)
    bit_arr = _u64(pool + 0x30)
    if not pool_arr or not bit_arr:
        return
    for i in range(min(size, 0x4000)):
        word = _u32(bit_arr + (i >> 5) * 4)
        if word is None:
            continue
        if (word >> (i & 0x1F)) & 1:
            ent = _u64(pool_arr + i * 8)
            if ent:
                yield ent

def _iter_generic_pool(pool):
    start = _u64(pool + 0x00)
    byte_arr = _u64(pool + 0x08)
    size = _u32(pool + 0x10) or 0
    item = _u32(pool + 0x14) or 0
    if not start or not byte_arr or not item:
        return
    flags = _P["read_bytes"](byte_arr, min(size, 0x8000))
    if not flags:
        return
    for i in range(min(size, len(flags))):
        if flags[i] & 0x80:                         # top bit set = occupied/valid
            yield start + i * item

def enumerate_entities(kind="ped", limit=128, with_handles=False):
    """Walk a pool -> list of entity pointers. kind: ped|vehicle|object. UNTESTED - verify AOBs."""
    if kind not in _POOL_AOB:
        return {"error": "kind must be ped|vehicle|object"}
    pattern, ptype = _POOL_AOB[kind]
    pool = _resolve_pool_global(pattern)
    if not pool:
        return {"error": f"could not resolve {kind} pool (AOB miss -> verify pattern for this build)"}
    # shape sanity: a real pool's data pointer (+0x00) must be a heap address. If it's module/code,
    # the AOB matched the wrong site for this build -> fail honestly instead of emitting garbage.
    head = _u64(pool + 0x00)
    if not _looks_heap(head):
        return {"error": f"{kind} pool AOB resolved to a non-pool struct at 0x{pool:X} "
                         f"(data ptr 0x{(head or 0):X} is in module/code range, not heap) -- "
                         f"re-derive the {kind} AOB for build 3788",
                "pool": f"0x{pool:X}", "data_ptr": f"0x{(head or 0):X}"}
    it = _iter_vehicle_pool(pool) if ptype == "vehicle" else _iter_generic_pool(pool)
    ents, n = [], 0
    for ent in it:
        rec = {"ptr": f"0x{ent:X}"}
        if with_handles:
            rec["handle"] = _ptr_to_handle(ent)
        ents.append(rec)
        n += 1
        if n >= limit:
            break
    return {"success": True, "kind": kind, "pool": f"0x{pool:X}", "count": len(ents), "entities": ents,
            "note": "UNTESTED off-game; if empty, re-derive the pool AOB for this build."}

# handle<->pointer bridge (Menyoo funcs, found by AOB; call via bridge.handle_call_function)
_HANDLE_FN = {"ptr2handle": None, "handle2ptr": None}
def _ptr_to_handle(ent_ptr):
    addr = _HANDLE_FN["ptr2handle"]
    if not addr:
        # _addEntityToPoolFunc = (pattern - 0x68)
        a = _scan_first("48 F7 F9 49 8B 48 08 48 63 D0 C1 E0 08 0F B6 1C 11 03 D8")
        addr = _HANDLE_FN["ptr2handle"] = (a - 0x68) if a else None
    if not addr:
        return None
    r = _P["handle_call_function"]({"address": f"0x{addr:X}", "arg_types": ["ptr"],
                                    "args": [ent_ptr], "return_type": "int"})
    return r.get("result")

# ============================================================================
# Nearby-entity natives (no pool walk)  -- allocate a ctypes buffer, pass its address, read back
# ============================================================================
def _nearby(native_name, ped_handle=None, num=16):
    if not _P.get("PYLOADER_AVAILABLE"):
        return {"error": "PyLoaderV not available"}
    gta = _P["gta"]
    if ped_handle is None:
        ped_handle = gta.invoke(_P["_joaat"]("player_ped_id"), return_type="int") if False else \
                     _P["handle_call_native_by_name"]({"name": "PLAYER_PED_ID"}).get("result")
    arr_size = num * 2 + 2
    buf = (ctypes.c_int * arr_size)()
    buf[0] = num
    r = _P["handle_call_function"]  # not used; natives go through call_native with a pointer arg
    # call the native with the buffer address as the out-pointer arg
    res = _P["handle_call_native_by_name"]({"name": native_name,
            "args": [ped_handle, ctypes.addressof(buf), -1], "return_type": "int"})
    cnt = res.get("result")
    if not isinstance(cnt, int):
        return {"error": f"{native_name} returned {res}"}
    handles = [buf[i * 2 + 2] for i in range(min(cnt, num))]
    return {"success": True, "count": cnt, "handles": handles}

def nearby_peds(num=16, ped_handle=None):     return _nearby("GET_PED_NEARBY_PEDS", ped_handle, num)
def nearby_vehicles(num=16, ped_handle=None): return _nearby("GET_PED_NEARBY_VEHICLES", ped_handle, num)

# ============================================================================
# Handlers + registration
# ============================================================================
def handle_read_global(p):   return read_global(p.get("index"), p.get("kind", "int"))
def handle_write_global(p):  return write_global(p.get("index"), p.get("value"), p.get("kind", "int"))
def handle_enumerate_entities(p):
    return enumerate_entities(p.get("kind", "ped"), int(p.get("limit", 128)), bool(p.get("with_handles")))
def handle_nearby_peds(p):     return nearby_peds(int(p.get("num", 16)))
def handle_nearby_vehicles(p): return nearby_vehicles(int(p.get("num", 16)))

# ---- Vehicle full-repair (Menyoo sequence: fix + deformation + health + dirt) -- UNTESTED -----
def repair_vehicle_full(handle=None):
    """Full repair via natives: SET_VEHICLE_FIXED + deformation-fixed + engine/petrol/body health +
    dirt 0 (MenyooSP GTAvehicle::Repair). handle=None -> player's current vehicle. Needs the live tick.
    For deformation that SET_VEHICLE_FIXED doesn't fully undo, the memory-level route is the CVehicle
    fragInst deformation buffer (AOB-resolve per build) - see RE-TOOLKIT-ADVANCED.md."""
    cn = _P.get("handle_call_native_by_name")
    if not cn:
        return {"error": "bridge not bound (no call_native handler)"}
    if handle is None:
        ped = cn({"name": "PLAYER_PED_ID"}).get("result")
        handle = cn({"name": "GET_VEHICLE_PED_IS_IN", "args": [ped, False], "return_type": "int"}).get("result")
    if not handle:
        return {"error": "no vehicle (enter one or pass a handle)"}
    seq = [("SET_VEHICLE_FIXED", [handle]),
           ("SET_VEHICLE_DEFORMATION_FIXED", [handle]),
           ("SET_VEHICLE_DIRT_LEVEL", [handle, 0.0]),
           ("SET_VEHICLE_ENGINE_HEALTH", [handle, 1000.0]),
           ("SET_VEHICLE_PETROL_TANK_HEALTH", [handle, 1000.0]),
           ("SET_VEHICLE_BODY_HEALTH", [handle, 1000.0])]
    applied = []
    for name, args in seq:
        r = cn({"name": name, "args": args, "return_type": "void"})
        applied.append({name: ("ok" if "error" not in r else r["error"])})
    return {"success": True, "handle": handle, "applied": applied}

def handle_repair_vehicle_full(p): return repair_vehicle_full(p.get("handle"))

RE_DYN_COMMANDS = {
    "read_global": handle_read_global,
    "write_global": handle_write_global,
    "enumerate_entities": handle_enumerate_entities,
    "nearby_peds": handle_nearby_peds,
    "nearby_vehicles": handle_nearby_vehicles,
    "repair_vehicle_full": handle_repair_vehicle_full,
}
# NOTE: these need the live game tick (natives/engine) -> do NOT mark off-thread.
